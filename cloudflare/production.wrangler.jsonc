{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hardburn-api-prod",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 30000
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://hardburn.vercel.app,https://speedkills-viewer2.vercel.app,https://hardburn-thegameband.vercel.app,https://hardburn-git-main-thegameband.vercel.app,https://hardburn.fun,https://www.hardburn.fun"
  },
  "secrets": {
    "required": [
      "BENCHMARK_KEY",
      "AUTH_SECRET"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LEAGUE",
        "class_name": "League"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "League"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hardburn-prod",
      "database_id": "992e7377-d6e2-4774-80c2-6712e72c2f4b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TRACES",
      "bucket_name": "hardburn-traces-prod"
    }
  ],
  "services": [
    {
      "binding": "SIMULATOR",
      "service": "hardburn-simulator-prod",
      "entrypoint": "Simulator"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "PREPARATIONS",
        "queue": "hardburn-preparations-prod"
      }
    ]
  }
}
