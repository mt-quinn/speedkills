{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hardburn-simulator-prod",
  "main": "src/simulator.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 60000
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "TRACES",
      "bucket_name": "hardburn-traces-prod"
    }
  ],
  "build": {
    "command": "node tools/build-cloudflare-sim.mjs"
  },
  "queues": {
    "consumers": [
      {
        "queue": "hardburn-preparations-prod",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 3,
        "retry_delay": 30,
        "max_concurrency": 1
      }
    ]
  },
  "services": [
    {
      "binding": "COMPLETION",
      "service": "hardburn-api-prod",
      "entrypoint": "Completion"
    }
  ]
}
